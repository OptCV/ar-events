// The single AR Creator Worker (ADR-014): SPA via Workers Static Assets + Hono API at /api/*.
// No secrets here. Secrets: `wrangler secret put <NAME>` (prod) / `.dev.vars` (local, gitignored).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ar-creator",
  "main": "../api/src/worker.ts",
  "compatibility_date": "2026-10-28",
  // Explicit for Better Auth (node:crypto, AsyncLocalStorage) and pg in later milestones.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Unknown non-API paths return index.html so client-side routes deep-link correctly.
    "not_found_handling": "single-page-application",
    // API requests always reach the Worker, even if a static file with the same path existed.
    "run_worker_first": ["/api/*"]
  },
  // Neon PostgreSQL (AWS US East) via Hyperdrive — config created with query caching DISABLED (ADR-017).
  // The ID is not a secret. No connection string or localConnectionString is stored here: local dev reads
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from the gitignored repo-root .env (npm run db:env).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8de2df3d333b4a1b9b07c18fbdd49d18" }],
  // Fail-closed production defaults (ADR-019). Local values come from apps/web/.dev.vars (npm run dev:env).
  // Before enabling auth in a deployed environment set: BETTER_AUTH_URL (https origin), EMAIL_FROM (verified
  // Resend domain), and the secrets BETTER_AUTH_SECRET + RESEND_API_KEY via `wrangler secret put`.
  // With BETTER_AUTH_URL empty, every /api/auth endpoint answers 503; sign-up stays off until explicitly enabled.
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "",
    "EMAIL_TRANSPORT": "resend",
    "EMAIL_FROM": "",
    "AUTH_SIGNUP_ENABLED": "false"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Isolated remote-test Worker (ADR-020). A SEPARATE Worker (`ar-creator-dev`), not a version of `ar-creator`,
  // so it can never inherit production bindings. Bound ONLY to the development Hyperdrive config
  // (Neon development branch, role ar_app, caching disabled). Production-strict auth settings; sign-up off.
  // Secret (set by the owner, hidden prompt): npx wrangler secret put BETTER_AUTH_SECRET --name ar-creator-dev
  // Build + deploy only via: npm run deploy:dev  (refuses while the subdomain placeholder is present)
  "env": {
    "dev": {
      "name": "ar-creator-dev",
      "workers_dev": true,
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f7b30d814f184296bb44518058778789" }],
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://ar-creator-dev.__WORKERS_SUBDOMAIN__.workers.dev",
        "EMAIL_TRANSPORT": "resend",
        "EMAIL_FROM": "",
        "AUTH_SIGNUP_ENABLED": "false"
      }
    }
  }
}
